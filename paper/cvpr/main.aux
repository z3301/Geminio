\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Target selection tracks the guide's retrieval of the target class.} One point per guide head (ResNet-18 client, 25 heads over three datasets): the AUROC with which the guide's query similarity ranks the target class on the attacker's auxiliary set, against the two target images' share of the summed per-example last-layer weight-gradient norms on the private batch. Equal contribution is 0.25. All ChestMNIST guides sit at or below 0.64 AUROC and no ChestMNIST head places more than a near-uniform share on the targets; among the UAV guides TeCoA-4 has the weakest retrieval and is the one UAV head below uniform. One private batch per dataset.}}{5}{figure.caption.16}\protected@file@percent }
\newlabel{fig:retrieval}{{2}{5}{\textbf {Target selection tracks the guide's retrieval of the target class.} One point per guide head (ResNet-18 client, 25 heads over three datasets): the AUROC with which the guide's query similarity ranks the target class on the attacker's auxiliary set, against the two target images' share of the summed per-example last-layer weight-gradient norms on the private batch. Equal contribution is 0.25. All ChestMNIST guides sit at or below 0.64 AUROC and no ChestMNIST head places more than a near-uniform share on the targets; among the UAV guides TeCoA-4 has the weakest retrieval and is the one UAV head below uniform. One private batch per dataset}{figure.caption.16}{}}
